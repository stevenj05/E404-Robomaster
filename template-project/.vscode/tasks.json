{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project (SCons)",
            "type": "shell",
            "command": "scons",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/template-project"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "focus": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean Build (SCons)",
            "type": "shell",
            "command": "scons",
            "args": ["-c"],
            "options": {
                "cwd": "${workspaceFolder}/template-project"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
